# FitSwap Docker Compose environment
# Copy this file to .env, replace placeholders with local-only values, and
# never commit the resulting .env file.

# -----------------------------------------------------------------------------
# Required local Docker infrastructure
# Use distinct, URL-safe values. Generate with: openssl rand -hex 32
# -----------------------------------------------------------------------------
POSTGRES_PASSWORD=replace-with-a-long-random-postgres-password
REDIS_PASSWORD=replace-with-a-different-long-random-redis-password

# -----------------------------------------------------------------------------
# Required API security
# Generate a different value for every secret. Do not reuse production values.
# -----------------------------------------------------------------------------
JWT_SECRET=replace-with-a-long-random-jwt-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-refresh-secret
AUDIT_HMAC_SECRET=replace-with-a-different-long-random-audit-secret

# -----------------------------------------------------------------------------
# Runtime and upload security
# Keep development locally. Production requires valid MFA and malware settings.
# -----------------------------------------------------------------------------
NODE_ENV=development
MFA_ENCRYPTION_KEY=
ADMIN_MFA_REQUIRED=false
CLAMAV_HOST=
CLAMAV_PORT=3310
MALWARE_SCAN_REQUIRED=false

# -----------------------------------------------------------------------------
# Authentication
# This public Google client ID is also passed to the Client Docker build.
# -----------------------------------------------------------------------------
GOOGLE_CLIENT_ID=your-web-client-id.apps.googleusercontent.com

# -----------------------------------------------------------------------------
# AI diet planner
# Server-only. Never use a VITE_ variable for this key.
# -----------------------------------------------------------------------------
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# -----------------------------------------------------------------------------
# Email delivery
# Brevo is preferred when BREVO_API_KEY is configured. SMTP is a fallback.
# -----------------------------------------------------------------------------
BREVO_API_KEY=
EMAIL_FROM="FitSwap <your-verified-sender@example.com>"

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="FitSwap <no-reply@example.com>"

# -----------------------------------------------------------------------------
# Platform payment receiving details
# Used only for FitSwap fees, subscriptions, and boosts.
# -----------------------------------------------------------------------------
PLATFORM_UPI_ID=
PLATFORM_UPI_PAYEE_NAME="FitSwap Business"

# Legacy Razorpay configuration. Leave blank unless Razorpay is enabled.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# -----------------------------------------------------------------------------
# AWS S3 uploads
# Keep verification PDFs, profile media, and support attachments private.
# -----------------------------------------------------------------------------
AWS_REGION=
AWS_BUCKET_NAME=
AWS_GYM_IMAGE_BUCKET_NAME=
AWS_GYM_IMAGE_BASE_URL=
AWS_PROFILE_IMAGE_BUCKET_NAME=
AWS_GYM_DOCUMENT_BUCKET_NAME=
AWS_SUPPORT_ATTACHMENT_BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
