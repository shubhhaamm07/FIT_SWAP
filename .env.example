# Copy this file to .env before starting Docker Compose.
# Use a URL-safe PostgreSQL password here (letters, numbers, underscores, hyphens).
POSTGRES_PASSWORD=replace-with-a-long-random-password
JWT_SECRET=replace-with-a-long-random-jwt-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-jwt-refresh-secret

# Optional: Google sign-in (the same client ID is passed safely to the Vite app).
GOOGLE_CLIENT_ID=your-web-client-id.apps.googleusercontent.com

# Brevo email delivery. It is preferred over SMTP when both variables exist.
# Use the sender address you verified in your Brevo account.
BREVO_API_KEY=xkeysib-your-brevo-api-key
EMAIL_FROM=FitSwap <your-verified-gmail@gmail.com>

# Optional: Razorpay features.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Optional: FitSwap platform-fee UPI receiving details.
PLATFORM_UPI_ID=
PLATFORM_UPI_PAYEE_NAME=

# Optional SMTP fallback. Brevo is recommended for hosted deployments.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-username
SMTP_PASSWORD=your-smtp-password
SMTP_FROM=FitSwap <no-reply@example.com>

# Optional: required only for S3-backed image uploads.
AWS_REGION=
AWS_BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
