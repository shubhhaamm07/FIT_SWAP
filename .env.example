# Copy this file to .env before starting Docker Compose. Never commit .env.
# Use URL-safe PostgreSQL and Redis passwords (letters, digits, _ and -).
POSTGRES_PASSWORD=replace-with-a-long-random-password
REDIS_PASSWORD=replace-with-a-different-long-random-password
JWT_SECRET=replace-with-a-long-random-jwt-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-jwt-refresh-secret
AUDIT_HMAC_SECRET=replace-with-a-separate-long-random-audit-secret

# Docker Compose defaults to development for local HTTP. Before a public
# deployment, set NODE_ENV=production, then configure the MFA and ClamAV
# variables below as required by Server/docs/security-deployment.md.
NODE_ENV=development
MFA_ENCRYPTION_KEY=
ADMIN_MFA_REQUIRED=false
CLAMAV_HOST=
CLAMAV_PORT=3310
MALWARE_SCAN_REQUIRED=false

# Optional: Google sign-in (the same client ID is passed safely to the Vite app).
GOOGLE_CLIENT_ID=your-web-client-id.apps.googleusercontent.com

# Optional: AI diet planner.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Brevo email delivery. It is preferred over SMTP when both variables exist.
# Use the sender address you verified in your Brevo account.
BREVO_API_KEY=xkeysib-your-brevo-api-key
EMAIL_FROM=FitSwap <your-verified-gmail@gmail.com>

# Optional: Razorpay features.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Optional: FitSwap platform-fee UPI receiving details.
PLATFORM_UPI_ID=
PLATFORM_UPI_PAYEE_NAME=

# Optional SMTP fallback. Brevo is recommended for hosted deployments.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-username
SMTP_PASSWORD=your-smtp-password
SMTP_FROM=FitSwap <no-reply@example.com>

# Optional AWS S3-backed uploads. Keep the final three buckets private.
AWS_REGION=
AWS_BUCKET_NAME=
AWS_GYM_IMAGE_BUCKET_NAME=
AWS_GYM_IMAGE_BASE_URL=
AWS_PROFILE_IMAGE_BUCKET_NAME=
AWS_GYM_DOCUMENT_BUCKET_NAME=
AWS_SUPPORT_ATTACHMENT_BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
