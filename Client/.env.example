# FitSwap React/Vite environment
# Copy to Client/.env for local development. Only VITE_ values reach the browser.
# Never add API keys, database URLs, JWT secrets, or AWS secret keys here.

# The Client always calls the same-origin /api path.
# Vite proxies it locally; Netlify/Nginx proxies it after deployment.
# Do not define VITE_API_URL.

# Public payment-provider identifier only. This is not a Razorpay secret.
VITE_RAZORPAY_KEY_ID=

# Public Google OAuth web client ID.
VITE_GOOGLE_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
