# Expo Go discovers your computer’s local address automatically.
# Optional override for a deployed API or a tunnel accessible to your phone:
EXPO_PUBLIC_API_URL=
# Existing website URL; used for secure checkout and email verification links.
EXPO_PUBLIC_WEB_URL=

# Optional Google sign-in. Use the same web client ID configured on the server.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
