generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                       String    @id @default(cuid())
  firstName                String
  lastName                 String
  email                    String    @unique
  // Stable Google account identifier (`sub`). Email addresses are not used as
  // the long-term Google identity because they can change.
  googleSubject            String?   @unique
  phone                    String?   @unique
  password                 String
  role                     UserRole  @default(USER)
  isActive                 Boolean   @default(true)
  username                 String?   @unique
  bio                      String?
  city                     String?
  isProfilePublic          Boolean   @default(true)
  emailVerifiedAt          DateTime?
  // Used to invalidate JWTs issued before a password reset or change.
  passwordChangedAt        DateTime?
  avatarUrl                String?
  avatarKey                String?
  coverUrl                 String?
  coverKey                 String?
  emailNotifications       Boolean   @default(true)
  marketplaceNotifications Boolean   @default(true)
  upiId                   String?
  upiPayeeName            String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  gyms             Gym[]
  memberships      UserMembership[]
  listings         MarketplaceListing[]
  transferRequests TransferRequest[]
  notifications    Notification[]
  savedListings    SavedListing[]
  payments         Payment[]
  announcements    Announcement[]       @relation("AnnouncementAuthor")
  adminAuditLogs   AdminAuditLog[]      @relation("AdminAuditAuthor")
  authTokens       AuthToken[]
  upiRequestsAsBuyer     UpiPaymentRequest[] @relation("UpiPaymentBuyer")
  upiRequestsAsRecipient UpiPaymentRequest[] @relation("UpiPaymentRecipient")
  platformPaymentRequests PlatformPaymentRequest[] @relation("PlatformPaymentBuyer")
  platformPaymentApprovals PlatformPaymentRequest[] @relation("PlatformPaymentApprover")
}

model Gym {
  id          String    @id @default(cuid())
  name        String
  description String?
  address     String
  city        String
  state       String
  pincode     String
  phone       String
  email       String?
  status      GymStatus @default(PENDING)

  ownerId String
  owner   User   @relation(fields: [ownerId], references: [id])

  plans MembershipPlan[]

  // ✅ NEW RELATION
  images GymImage[]
  upiPaymentRequests UpiPaymentRequest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model MembershipPlan {
  id                  String  @id @default(cuid())
  name                String
  description         String?
  durationInDays      Int
  price               Float
  transferable        Boolean @default(true)
  freezeAllowed       Boolean @default(false)
  transferFee         Float?
  minimumTransferDays Int     @default(30)
  maximumTransfers    Int?
  requiresGymApproval Boolean @default(true)
  allowOnlinePayment  Boolean @default(true)
  allowCashTransfer   Boolean @default(false)

  gymId String
  gym   Gym    @relation(fields: [gymId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships UserMembership[]
  payments    Payment[]
  upiPaymentRequests UpiPaymentRequest[]
}

model UserMembership {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id])

  planId String
  plan   MembershipPlan @relation(fields: [planId], references: [id])

  startDate DateTime
  endDate   DateTime

  // Keeps historical sales reporting correct if a plan price changes later.
  purchasePrice Float?
  transferCount Int    @default(0)

  status MembershipStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  listing MarketplaceListing?
}

model MarketplaceListing {
  id String @id @default(cuid())

  membershipId String         @unique
  membership   UserMembership @relation(fields: [membershipId], references: [id])

  sellerId String
  seller   User   @relation(fields: [sellerId], references: [id])

  askingPrice Float

  status ListingStatus @default(ACTIVE)

  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transferRequests TransferRequest[]
  savedBy          SavedListing[]
  payments         Payment[]
  upiPaymentRequests UpiPaymentRequest[]
  platformPaymentRequests PlatformPaymentRequest[]
  boostedUntil DateTime?
}

model SavedListing {
  id        String   @id @default(cuid())
  userId    String
  listingId String
  createdAt DateTime @default(now())

  user    User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  listing MarketplaceListing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([userId, listingId])
  @@index([userId])
}

model TransferRequest {
  id String @id @default(cuid())

  listingId String
  listing   MarketplaceListing @relation(fields: [listingId], references: [id])

  buyerId String
  buyer   User   @relation(fields: [buyerId], references: [id])

  status TransferRequestStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([listingId, buyerId])
}

model Payment {
  id String @id @default(cuid())

  listingId String?
  listing   MarketplaceListing? @relation(fields: [listingId], references: [id])

  planId String?
  plan   MembershipPlan? @relation(fields: [planId], references: [id])

  buyerId String
  buyer   User   @relation(fields: [buyerId], references: [id])

  razorpayOrderId   String  @unique
  razorpayPaymentId String? @unique
  razorpaySignature String?

  amount   Int
  currency String        @default("INR")
  status   PaymentStatus @default(CREATED)
  type     PaymentType   @default(MARKETPLACE_TRANSFER)

  createdAt  DateTime  @default(now())
  verifiedAt DateTime?

  @@index([listingId])
  @@index([planId])
  @@index([buyerId])
  @@index([status])
}

model UpiPaymentRequest {
  id String @id @default(cuid())

  kind   UpiPaymentKind
  status UpiPaymentStatus @default(AWAITING_PAYMENT)

  buyerId String
  buyer   User @relation("UpiPaymentBuyer", fields: [buyerId], references: [id])

  recipientId String
  recipient   User @relation("UpiPaymentRecipient", fields: [recipientId], references: [id])

  listingId String?
  listing   MarketplaceListing? @relation(fields: [listingId], references: [id])

  gymId String?
  gym   Gym? @relation(fields: [gymId], references: [id])

  planId String?
  plan   MembershipPlan? @relation(fields: [planId], references: [id])

  amount        Int
  currency      String @default("INR")
  paymentRef    String @unique
  recipientUpiId String
  payeeName     String

  // A bank/UPI reference must only be associated with one FitSwap request.
  // PostgreSQL permits multiple nulls in a unique column, so unpaid requests
  // remain valid while submitted UTRs are protected from reuse.
  utr                 String? @unique
  buyerMarkedPaidAt   DateTime?
  recipientConfirmedAt DateTime?
  gymApprovedAt       DateTime?
  completedAt         DateTime?
  cancelledAt         DateTime?
  rejectedAt          DateTime?
  rejectionReason     String?
  expiresAt           DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([buyerId, status])
  @@index([recipientId, status])
  @@index([gymId, status])
  @@index([listingId, status])
  @@index([expiresAt])
}

model PlatformPaymentRequest {
  id String @id @default(cuid())

  kind   PlatformPaymentKind
  status UpiPaymentStatus @default(AWAITING_PAYMENT)
  planCode String

  buyerId String
  buyer   User @relation("PlatformPaymentBuyer", fields: [buyerId], references: [id])

  listingId String?
  listing   MarketplaceListing? @relation(fields: [listingId], references: [id])

  confirmedByAdminId String?
  confirmedByAdmin User? @relation("PlatformPaymentApprover", fields: [confirmedByAdminId], references: [id])

  amount           Int
  currency         String @default("INR")
  paymentRef       String @unique
  platformUpiId    String
  platformPayeeName String
  benefitDays      Int
  benefitExpiresAt DateTime?

  utr               String? @unique
  buyerMarkedPaidAt DateTime?
  adminConfirmedAt  DateTime?
  completedAt       DateTime?
  cancelledAt       DateTime?
  rejectedAt        DateTime?
  rejectionReason   String?
  expiresAt         DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([buyerId, status])
  @@index([listingId, status])
  @@index([status])
  @@index([expiresAt])
}

model Notification {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id])

  title   String
  message String

  isRead Boolean @default(false)

  createdAt DateTime @default(now())
}

model Announcement {
  id             String               @id @default(cuid())
  adminId        String
  admin          User                 @relation("AnnouncementAuthor", fields: [adminId], references: [id])
  title          String
  message        String
  audience       AnnouncementAudience
  recipientCount Int                  @default(0)
  createdAt      DateTime             @default(now())

  @@index([createdAt])
  @@index([audience])
}

model AdminAuditLog {
  id         String           @id @default(cuid())
  adminId    String
  admin      User             @relation("AdminAuditAuthor", fields: [adminId], references: [id])
  action     AdminAuditAction
  targetType String
  targetId   String?
  summary    String
  metadata   Json?
  createdAt  DateTime         @default(now())

  @@index([createdAt])
  @@index([adminId])
  @@index([action])
}

// Keeps an immutable record of each policy decision and membership handover.
// This is deliberately separate from admin-only audit logs because a seller,
// buyer, or gym owner may trigger an event in the transfer workflow.
model TransferAuditLog {
  id           String   @id @default(cuid())
  membershipId String
  listingId    String?
  actorId      String?
  actorRole    String?
  action       String
  summary      String
  metadata     Json?
  createdAt    DateTime @default(now())

  @@index([membershipId, createdAt])
  @@index([listingId, createdAt])
  @@index([actorId, createdAt])
  @@index([action])
}

model AuthToken {
  id        String        @id @default(cuid())
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String        @unique
  type      AuthTokenType
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime      @default(now())

  @@index([userId, type])
  @@index([expiresAt])
}

model GymImage {
  id String @id @default(cuid())

  gymId String
  gym   Gym    @relation(fields: [gymId], references: [id], onDelete: Cascade)

  imageKey String @unique
  imageUrl String

  isPrimary Boolean @default(false)

  displayOrder Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([gymId])
}

enum UserRole {
  USER
  GYM_OWNER
  GYM_STAFF
  ADMIN
}

enum GymStatus {
  PENDING
  APPROVED
  REJECTED
}

enum MembershipStatus {
  ACTIVE
  EXPIRED
  FROZEN
  TRANSFERRED
}

enum ListingStatus {
  DRAFT
  ACTIVE
  PAUSED
  RESERVED
  PAYMENT_PENDING
  PAYMENT_SUCCESS
  PAYMENT_FAILED
  TRANSFER_PENDING
  GYM_APPROVAL_PENDING
  TRANSFER_REJECTED
  SOLD
  CANCELLED
  EXPIRED
}

enum TransferRequestStatus {
  PENDING
  AWAITING_GYM_APPROVAL
  APPROVED
  REJECTED
  CANCELLED
}

enum PaymentStatus {
  CREATED
  PAID
  FAILED
}

enum PaymentType {
  MARKETPLACE_TRANSFER
  GYM_MEMBERSHIP
}

enum UpiPaymentKind {
  GYM_MEMBERSHIP
  MARKETPLACE_TRANSFER
}

enum PlatformPaymentKind {
  OWNER_SUBSCRIPTION
  LISTING_BOOST
}

enum UpiPaymentStatus {
  AWAITING_PAYMENT
  BUYER_MARKED_PAID
  AWAITING_GYM_APPROVAL
  COMPLETED
  REJECTED
  CANCELLED
  EXPIRED
  DISPUTED
}

enum AnnouncementAudience {
  ALL_USERS
  MEMBERS
  GYM_OWNERS
  SELECTED_USERS
}

enum AuthTokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

enum AdminAuditAction {
  ANNOUNCEMENT_SENT
  GYM_STATUS_UPDATED
  LISTING_STATUS_UPDATED
  USER_ROLE_UPDATED
  USER_ACCESS_UPDATED
  TRANSFER_RESOLVED
  PLATFORM_PAYMENT_CONFIRMED
  PLATFORM_PAYMENT_REJECTED
}
