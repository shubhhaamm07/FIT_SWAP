generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  firstName String
  lastName  String
  email     String   @unique
  phone     String?  @unique
  password  String
  role      UserRole @default(USER)
  avatarUrl String?
  avatarKey String?
  coverUrl  String?
  coverKey  String?
  emailNotifications       Boolean @default(true)
  marketplaceNotifications Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  gyms             Gym[]
  memberships      UserMembership[]
  listings         MarketplaceListing[]
  transferRequests TransferRequest[]
  notifications    Notification[]
  savedListings    SavedListing[]
  announcements    Announcement[] @relation("AnnouncementAuthor")
  adminAuditLogs   AdminAuditLog[] @relation("AdminAuditAuthor")
}

model Gym {
  id          String    @id @default(cuid())
  name        String
  description String?
  address     String
  city        String
  state       String
  pincode     String
  phone       String
  email       String?
  status      GymStatus @default(PENDING)

  ownerId String
  owner   User   @relation(fields: [ownerId], references: [id])

  plans MembershipPlan[]

  // ✅ NEW RELATION
  images GymImage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model MembershipPlan {
  id             String  @id @default(cuid())
  name           String
  description    String?
  durationInDays Int
  price          Float
  transferable   Boolean @default(true)
  freezeAllowed  Boolean @default(false)
  transferFee    Float?

  gymId String
  gym   Gym    @relation(fields: [gymId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships UserMembership[]
}

model UserMembership {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id])

  planId String
  plan   MembershipPlan @relation(fields: [planId], references: [id])

  startDate DateTime
  endDate   DateTime

  // Keeps historical sales reporting correct if a plan price changes later.
  purchasePrice Float?

  status MembershipStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  listing MarketplaceListing?
}

model MarketplaceListing {
  id String @id @default(cuid())

  membershipId String         @unique
  membership   UserMembership @relation(fields: [membershipId], references: [id])

  sellerId String
  seller   User   @relation(fields: [sellerId], references: [id])

  askingPrice Float

  status ListingStatus @default(ACTIVE)

  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transferRequests TransferRequest[]
  savedBy          SavedListing[]
}

model SavedListing {
  id        String   @id @default(cuid())
  userId    String
  listingId String
  createdAt DateTime @default(now())

  user    User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  listing MarketplaceListing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([userId, listingId])
  @@index([userId])
}

model TransferRequest {
  id String @id @default(cuid())

  listingId String
  listing   MarketplaceListing @relation(fields: [listingId], references: [id])

  buyerId String
  buyer   User   @relation(fields: [buyerId], references: [id])

  status TransferRequestStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([listingId, buyerId])
}

model Notification {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id])

  title   String
  message String

  isRead Boolean @default(false)

  createdAt DateTime @default(now())
}

model Announcement {
  id             String               @id @default(cuid())
  adminId        String
  admin          User                 @relation("AnnouncementAuthor", fields: [adminId], references: [id])
  title          String
  message        String
  audience       AnnouncementAudience
  recipientCount Int                  @default(0)
  createdAt      DateTime             @default(now())

  @@index([createdAt])
  @@index([audience])
}

model AdminAuditLog {
  id         String          @id @default(cuid())
  adminId    String
  admin      User            @relation("AdminAuditAuthor", fields: [adminId], references: [id])
  action     AdminAuditAction
  targetType String
  targetId   String?
  summary    String
  metadata   Json?
  createdAt  DateTime        @default(now())

  @@index([createdAt])
  @@index([adminId])
  @@index([action])
}

model GymImage {
  id String @id @default(cuid())

  gymId String
  gym   Gym    @relation(fields: [gymId], references: [id], onDelete: Cascade)

  imageKey String @unique
  imageUrl String

  isPrimary Boolean @default(false)

  displayOrder Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([gymId])
}

enum UserRole {
  USER
  GYM_OWNER
  GYM_STAFF
  ADMIN
}

enum GymStatus {
  PENDING
  APPROVED
  REJECTED
}

enum MembershipStatus {
  ACTIVE
  EXPIRED
  FROZEN
  TRANSFERRED
}

enum ListingStatus {
  DRAFT
  ACTIVE
  PAUSED
  RESERVED
  PAYMENT_PENDING
  PAYMENT_SUCCESS
  PAYMENT_FAILED
  TRANSFER_PENDING
  GYM_APPROVAL_PENDING
  TRANSFER_REJECTED
  SOLD
  CANCELLED
  EXPIRED
}

enum TransferRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum AnnouncementAudience {
  ALL_USERS
  MEMBERS
  GYM_OWNERS
  SELECTED_USERS
}

enum AdminAuditAction {
  ANNOUNCEMENT_SENT
  GYM_STATUS_UPDATED
  LISTING_STATUS_UPDATED
  USER_ROLE_UPDATED
  TRANSFER_RESOLVED
}
