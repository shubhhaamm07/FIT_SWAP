PORT=8000
DATABASE_URL=postgresql://postgres:your-url-encoded-password@localhost:5432/fitswap_
JWT_SECRET=replace-with-a-long-random-jwt-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-jwt-refresh-secret
# A separate 32+ byte secret protects transfer-audit hash chains.
AUDIT_HMAC_SECRET=replace-with-a-long-random-audit-secret
# Required for administrator MFA in production. Use exactly 32 random bytes,
# supplied as 64 hexadecimal characters or base64, for example:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
MFA_ENCRYPTION_KEY=
# Production always enforces MFA for ADMIN accounts. Set this locally to test
# the enrolment screen before deployment.
ADMIN_MFA_REQUIRED=false
# Existing JWTs without a server-side session id are rejected by default.
ALLOW_LEGACY_JWT=false
BCRYPT_ROUNDS=12
BREACHED_PASSWORD_CHECK_ENABLED=true
CLIENT_URL=http://localhost:5173
# Optional comma-separated list for production and deploy previews.
# When set, CLIENT_URLS takes precedence over CLIENT_URL.
CLIENT_URLS=http://localhost:5173,https://your-site.netlify.app

# Calendar timezone used by membership-expiry reminders (30/7/1/0 days).
APP_TIME_ZONE=Asia/Kolkata

# Google Identity Services. Create a Web OAuth client in Google Cloud Console.
# This client ID is safe to also use as VITE_GOOGLE_CLIENT_ID in Client/.env.
GOOGLE_CLIENT_ID=your-web-client-id.apps.googleusercontent.com

# Public receiving details for FitSwap's own fees only (subscriptions and listing boosts).
# Do not use a seller's or gym's UPI ID here.
PLATFORM_UPI_ID=fitswap-business@yourbank
PLATFORM_UPI_PAYEE_NAME=FitSwap Business

# Brevo email delivery (recommended for free Render instances).
# Verify a sender email address in Brevo, create an API key, and use the
# verified sender below. Brevo uses HTTPS, so it does not depend on SMTP ports.
BREVO_API_KEY=your-brevo-api-key
EMAIL_FROM=FitSwap <your-verified-sender@example.com>


# Groq is used only by the server to create AI-generated wellness meal ideas.
# Never put this value in Client/.env or any VITE_ variable.
GROQ_API_KEY=your-groq-api-key
# Change this only if you select another Groq model that supports Structured Outputs.
GROQ_MODEL=openai/gpt-oss-20b


# Optional SMTP fallback for local development or paid hosting. These values
# are server-only; never add them to the Client. Gmail requires an App Password
# and must send from SMTP_USER or a verified Gmail "Send mail as" alias.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=yourgmail@gmail.com
SMTP_PASSWORD=your-16-character-app-password-without-spaces
SMTP_FROM=FitSwap <yourgmail@gmail.com>

# Optional: required for S3-backed image uploads.
AWS_REGION=
AWS_BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Keep public gym images and private profile media in separate buckets. If
# omitted, the main AWS_BUCKET_NAME is used for backward compatibility.
AWS_GYM_IMAGE_BUCKET_NAME=
AWS_GYM_IMAGE_BASE_URL=
AWS_PROFILE_IMAGE_BUCKET_NAME=

# Optional: use a separate private bucket for gym verification PDFs.
# Otherwise AWS_BUCKET_NAME is used. Do not grant public access to gym-verification/*.
AWS_GYM_DOCUMENT_BUCKET_NAME=

# Optional: use a separate private bucket for support-message attachments.
# Otherwise AWS_BUCKET_NAME is used. Do not grant public access to support/*.
AWS_SUPPORT_ATTACHMENT_BUCKET_NAME=

# ClamAV scans gym-verification PDFs and support attachments before storage.
# Production upload endpoints fail closed if this is not configured.
CLAMAV_HOST=
CLAMAV_PORT=3310
MALWARE_SCAN_REQUIRED=false

# Recommended in production: shares rate limits and relays SSE notifications
# between every Render API instance.
REDIS_URL=redis://default:password@host:6379

# Demo data is blocked in production unless this explicit escape hatch is set.
ALLOW_PRODUCTION_SEED=false
SEED_TEST_PASSWORD=choose-a-strong-local-demo-password
