PORT=8000
DATABASE_URL=postgresql://postgres:your-url-encoded-password@localhost:5432/fitswap_
JWT_SECRET=replace-with-a-long-random-jwt-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-jwt-refresh-secret
CLIENT_URL=http://localhost:5173
# Optional comma-separated list for production and deploy previews.
# When set, CLIENT_URLS takes precedence over CLIENT_URL.
CLIENT_URLS=http://localhost:5173,https://your-site.netlify.app

# Google Identity Services. Create a Web OAuth client in Google Cloud Console.
# This client ID is safe to also use as VITE_GOOGLE_CLIENT_ID in Client/.env.
GOOGLE_CLIENT_ID=your-web-client-id.apps.googleusercontent.com

# Public receiving details for FitSwap's own fees only (subscriptions and listing boosts).
# Do not use a seller's or gym's UPI ID here.
PLATFORM_UPI_ID=fitswap-business@yourbank
PLATFORM_UPI_PAYEE_NAME=FitSwap Business

# Server-only Razorpay credentials. Never expose the secret to Vite/React.
RAZORPAY_KEY_ID=rzp_test_your_public_key_id
RAZORPAY_KEY_SECRET=your_razorpay_test_secret

# Brevo email delivery (recommended for free Render instances).
# Verify a sender email address in Brevo, create an API key, and use the
# verified sender below. Brevo uses HTTPS, so it does not depend on SMTP ports.
BREVO_API_KEY=your-brevo-api-key
EMAIL_FROM=FitSwap <your-verified-sender@example.com>


# Gemini is used only by the server to create AI-generated wellness meal ideas.
# Never put this value in Client/.env or any VITE_ variable.
GEMINI_API_KEY=your-google-ai-studio-api-key
# Change this only if you use another Gemini model enabled for your API key.
GEMINI_MODEL=gemini-2.5-flash


# Optional SMTP fallback for local development or paid hosting. These values
# are server-only; never add them to the Client. Gmail requires an App Password
# and must send from SMTP_USER or a verified Gmail "Send mail as" alias.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=yourgmail@gmail.com
SMTP_PASSWORD=your-16-character-app-password-without-spaces
SMTP_FROM=FitSwap <yourgmail@gmail.com>

# Optional: required for S3-backed image uploads.
AWS_REGION=
AWS_BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
