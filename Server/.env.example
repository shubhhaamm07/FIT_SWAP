PORT=8000
DATABASE_URL=postgresql://postgres:your-url-encoded-password@localhost:5432/fitswap_
JWT_SECRET=replace-with-a-long-random-jwt-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-jwt-refresh-secret
CLIENT_URL=http://localhost:5173

# Google Identity Services. Create a Web OAuth client in Google Cloud Console.
# This client ID is safe to also use as VITE_GOOGLE_CLIENT_ID in Client/.env.
GOOGLE_CLIENT_ID=your-web-client-id.apps.googleusercontent.com

# Public receiving details for FitSwap's own fees only (subscriptions and listing boosts).
# Do not use a seller's or gym's UPI ID here.
PLATFORM_UPI_ID=fitswap-business@yourbank
PLATFORM_UPI_PAYEE_NAME=FitSwap Business

# Server-only Razorpay credentials. Never expose the secret to Vite/React.
RAZORPAY_KEY_ID=rzp_test_your_public_key_id
RAZORPAY_KEY_SECRET=your_razorpay_test_secret

# SMTP email delivery. These values are server-only; never add them to the Client.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-username
SMTP_PASSWORD=your-smtp-password
SMTP_FROM=FitSwap <no-reply@example.com>

# Optional: required for S3-backed image uploads.
AWS_REGION=
AWS_BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
