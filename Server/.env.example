# FitSwap API environment for direct local development
# Copy this file to Server/.env, replace placeholders, and never commit it.

# -----------------------------------------------------------------------------
# Server and database
# -----------------------------------------------------------------------------
PORT=8000
NODE_ENV=development
DATABASE_URL="postgresql://postgres:your-url-encoded-password@localhost:5432/fitswap_?schema=public"
APP_TIME_ZONE=Asia/Kolkata

# -----------------------------------------------------------------------------
# Authentication and security
# Generate distinct values with: openssl rand -hex 32
# -----------------------------------------------------------------------------
JWT_SECRET=replace-with-a-long-random-jwt-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-refresh-secret
AUDIT_HMAC_SECRET=replace-with-a-different-long-random-audit-secret
ALLOW_LEGACY_JWT=false
BCRYPT_ROUNDS=12
BREACHED_PASSWORD_CHECK_ENABLED=true

# Production always requires administrator MFA. MFA_ENCRYPTION_KEY must be
# exactly 32 random bytes, encoded as 64 hexadecimal characters or base64.
MFA_ENCRYPTION_KEY=
ADMIN_MFA_REQUIRED=false

# -----------------------------------------------------------------------------
# Client CORS origins
# CLIENT_URLS is optional and overrides CLIENT_URL when provided.
# -----------------------------------------------------------------------------
CLIENT_URL=http://localhost:5173
CLIENT_URLS=http://localhost:5173

# -----------------------------------------------------------------------------
# Google sign-in
# This client ID is safe to also place in Client/.env as VITE_GOOGLE_CLIENT_ID.
# -----------------------------------------------------------------------------
GOOGLE_CLIENT_ID=your-web-client-id.apps.googleusercontent.com

# -----------------------------------------------------------------------------
# AI diet planner
# Server-only. Never place this key in Client/.env or a VITE_ variable.
# -----------------------------------------------------------------------------
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# -----------------------------------------------------------------------------
# Email delivery
# Brevo is recommended for hosted deployments. SMTP is an optional fallback.
# -----------------------------------------------------------------------------
BREVO_API_KEY=
EMAIL_FROM="FitSwap <your-verified-sender@example.com>"

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="FitSwap <no-reply@example.com>"

# -----------------------------------------------------------------------------
# FitSwap platform payment receiving details
# Do not enter a member's, seller's, or gym's UPI ID here.
# -----------------------------------------------------------------------------
PLATFORM_UPI_ID=
PLATFORM_UPI_PAYEE_NAME="FitSwap Business"

# -----------------------------------------------------------------------------
# AWS S3 uploads
# AWS_BUCKET_NAME is the backward-compatible fallback. Prefer separate buckets:
# public gym images; private profiles, verification PDFs, and support files.
# -----------------------------------------------------------------------------
AWS_REGION=
AWS_BUCKET_NAME=
AWS_GYM_IMAGE_BUCKET_NAME=
AWS_GYM_IMAGE_BASE_URL=
AWS_PROFILE_IMAGE_BUCKET_NAME=
AWS_GYM_DOCUMENT_BUCKET_NAME=
AWS_SUPPORT_ATTACHMENT_BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# -----------------------------------------------------------------------------
# Redis and malware scanning
# REDIS_URL is optional locally; production should use managed Redis.
# Example: redis://:password@host:6379
# -----------------------------------------------------------------------------
REDIS_URL=
CLAMAV_HOST=
CLAMAV_PORT=3310
MALWARE_SCAN_REQUIRED=false

# -----------------------------------------------------------------------------
# Demo data guard
# Never enable production seed data unless intentionally required.
# -----------------------------------------------------------------------------
ALLOW_PRODUCTION_SEED=false
SEED_TEST_PASSWORD=choose-a-strong-local-demo-password
